# fleet.env.example — plantilla de credenciales para la VM.
#
#   sudo mkdir -p /etc/campus-ems
#   sudo cp ops/fleet.env.example /etc/campus-ems/fleet.env
#   sudo nano /etc/campus-ems/fleet.env     # pegar los connection strings
#   sudo chmod 600 /etc/campus-ems/fleet.env
#   sudo chown azureuser:azureuser /etc/campus-ems/fleet.env
#
# NUNCA copiar este archivo con valores reales al repositorio.

CS_D1=HostName=<hub>.azure-devices.net;DeviceId=campus-ems-01;SharedAccessKey=<key>
CS_D2=HostName=<hub>.azure-devices.net;DeviceId=campus-ems-02;SharedAccessKey=<key>
CS_D3=HostName=<hub>.azure-devices.net;DeviceId=campus-ems-03;SharedAccessKey=<key>
CS_D4=HostName=<hub>.azure-devices.net;DeviceId=campus-ems-04;SharedAccessKey=<key>
CS_D5=HostName=<hub>.azure-devices.net;DeviceId=campus-ems-05;SharedAccessKey=<key>
CS_D6=HostName=<hub>.azure-devices.net;DeviceId=campus-ems-06;SharedAccessKey=<key>
CS_D7=HostName=<hub>.azure-devices.net;DeviceId=campus-ems-07;SharedAccessKey=<key>
CS_D8=HostName=<hub>.azure-devices.net;DeviceId=campus-ems-08;SharedAccessKey=<key>
CS_D9=HostName=<hub>.azure-devices.net;DeviceId=campus-ems-09;SharedAccessKey=<key>
CS_D10=HostName=<hub>.azure-devices.net;DeviceId=campus-ems-10;SharedAccessKey=<key>

D8_INTERVAL=60
