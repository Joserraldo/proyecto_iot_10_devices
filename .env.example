# ==============================================================
# campus-ems — Variables de entorno
# NUNCA commitear .env con valores reales. Solo .env.example.
# Copiar a .env y completar con valores obtenidos de Azure.
# ==============================================================

# --------------------------------------------------------------
# AZURE IOT CENTRAL — DPS (Device Provisioning Service)
# Obtener desde: IoT Central → Administration → Device connection
# --------------------------------------------------------------
DPS_ID_SCOPE=0neXXXXXXXX

# Clave maestra para derivar claves por dispositivo (con provision_devices.py)
DPS_MASTER_KEY=

# --------------------------------------------------------------
# CONNECTION STRINGS individuales por dispositivo
# Generar con: python provision_devices.py
# Formato: HostName=xxx.azure-devices.net;DeviceId=xxx;SharedAccessKey=xxx
# --------------------------------------------------------------

# D1 — Estación meteo campus — 15 s
IOT_CENTRAL_DPS_CONNECTION_STRING=
IOT_CENTRAL_DEVICE_ID_D1=campus-ems-01

# D2 — Meteo patio (bridge Wokwi→Azure) — 30 s
# IOT_CENTRAL_DPS_CONNECTION_STRING arriba aplica también al bridge
IOT_CENTRAL_DEVICE_ID_D2=campus-ems-02

# D3 — Incendio Bloque A — 60 s
# NOTA: D3 usa una variable de nombre distinto al resto (legacy).
# Copiar el mismo connection string de D3 aquí:
IOT_CENTRAL_DPS_CONNECTION=
IOT_CENTRAL_DEVICE_ID=campus-ems-03

# D4 — Incendio Laboratorio — 60 s
IOT_CENTRAL_DEVICE_ID_D4=campus-ems-04

# D5 — Calidad aire aula — 15 s
IOT_CENTRAL_DEVICE_ID_D5=campus-ems-05

# D6 — Calidad aire exterior — 300 s
IOT_CENTRAL_DEVICE_ID_D6=campus-ems-06

# D7 — Acceso principal — 30 s
IOT_CENTRAL_DEVICE_ID_D7=campus-ems-07

# D8 — Cerramiento norte — 60 s
# D8 acepta AZURE_CONNECTION_STRING como alias
AZURE_CONNECTION_STRING=
IOT_CENTRAL_DEVICE_ID_D8=campus-ems-08
D8_DEVICE_ID=campus-ems-08

# D9 — Evacuación pasillo — 45 s
IOT_CENTRAL_DEVICE_ID_D9=campus-ems-09

# D10 — Puesto de mando — 20 s
IOT_CENTRAL_DEVICE_ID_D10=campus-ems-10

# --------------------------------------------------------------
# INTERVALOS (segundos) — no modificar salvo pruebas rápidas
# --------------------------------------------------------------
SAMPLE_INTERVAL_D1=15
SAMPLE_INTERVAL_D3=60
SAMPLE_INTERVAL_D4=60
SAMPLE_INTERVAL_D5=15
SAMPLE_INTERVAL_D6=300
SAMPLE_INTERVAL_D7=30
SAMPLE_INTERVAL_D9=45
SAMPLE_INTERVAL_D10=20
D8_INTERVAL=60

# --------------------------------------------------------------
# D5 — Open-Meteo (sin key — gratuito)
# Coordenadas: Bucaramanga, Colombia (UNAB)
# --------------------------------------------------------------
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
LATITUDE=7.1254
LONGITUDE=-73.1198

# --------------------------------------------------------------
# D6 — WAQI (World Air Quality Index)
# Token gratuito en: https://aqicn.org/data-platform/token/
# Dejar vacío = modo fallback (Open-Meteo + AQI simulado)
# --------------------------------------------------------------
WAQI_TOKEN=
WAQI_STATION=bucaramanga

# --------------------------------------------------------------
# D7 — MQTT explícito (broker público para demo)
# --------------------------------------------------------------
MQTT_BROKER=test.mosquitto.org
MQTT_PORT=1883
MQTT_TOPIC_D7=campus/ems/D7

# --------------------------------------------------------------
# D2 — Bridge Wokwi → Azure (mqtt_bridge_wokwi.py)
# --------------------------------------------------------------
WOKWI_MQTT_BROKER=test.mosquitto.org
WOKWI_MQTT_PORT=1883
WOKWI_MQTT_TOPIC=campus/ems/D2

# --------------------------------------------------------------
# D9 — Umbral de emergencia de iluminación
# --------------------------------------------------------------
EMERGENCY_LUX_THRESHOLD=20.0

# --------------------------------------------------------------
# D8 — Ruta del CSV histórico
# Por defecto: data/perimetro_norte_4dias.csv (relativo al repo)
# --------------------------------------------------------------
# D8_CSV_PATH=/ruta/absoluta/al/csv
