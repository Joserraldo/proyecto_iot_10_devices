# Azure IoT Central - Variables de Entorno
# ==============================================
# Este archivo ejemplifica las variables necesarias para el proyecto.
# NUNCA commitear el archivo .env real con valores secretos.
# Copiar este archivo a .env y completar con valores reales solo en entorno local.

# Azure IoT Central Configuration
IOT_CENTRAL_URL=https://tu-repositorio-iotcentral.azure-devices.net
IOT_CENTRAL_DPS_ID_SCOPE=0ne000XXYYZZ

# Device Provisioning Service
DPS_ID_SCOPE=
DPS_REGISTRATION_ID=${DEVICE_ID}
DPS_SYMMETRIC_KEY=

# Device Specific (example for one device)
DEVICE_ID=dispositivo-01
DEVICE_KEY=your-device-key-here
DEVICE_MODEL_id=temperature-sensor

# MQTT Configuration
MQTT_BROKER=${IOT_CENTRAL_URL}
MQTT_PORT=8883
MQTT_TLS_ENABLED=true

# API Públicas
OPEN_METEO_URL=https://api.open-meteo.com/v1/weather
ATLAS_WEATHER_URL=https://api.atlas.microsoft.com/weather/v1

# Wokwi Local
WOKWI_LOCAL=true

# Intervalo de muestreo (segundos)
SAMPLE_INTERVAL_D1=15
SAMPLE_INTERVAL_D2=30
SAMPLE_INTERVAL_D3=60
SAMPLE_INTERVAL_D4=60
SAMPLE_INTERVAL_D5=15
SAMPLE_INTERVAL_D6=300
SAMPLE_INTERVAL_D7=30
SAMPLE_INTERVAL_D8=60
SAMPLE_INTERVAL_D9=45
SAMPLE_INTERVAL_D10=20